<?xml version="1.0" encoding="UTF-8"?>
<CHandlingDataMgr>
  <HandlingData>
    <Item type="CHandlingData">
      <handlingName>ASBO</handlingName>

      <!-- 소형 해치백 / 컴팩트카 -->
      <fMass value="1280.000000" />
      <fInitialDragCoeff value="7.000000" />
      <fPercentSubmerged value="85.000000" />

      <!-- 가벼운 차체, 전복 억제를 위해 무게중심 살짝 낮춤 -->
      <vecCentreOfMassOffset x="0.000000" y="0.010000" z="-0.125000" />
      <vecInertiaMultiplier x="1.000000" y="1.080000" z="1.320000" />

      <!-- 전륜구동 -->
      <fDriveBiasFront value="1.000000" />
      <nInitialDriveGears value="6" />

      <!-- 순정 0단계 -->
      <fInitialDriveForce value="0.330400" />
      <fDriveInertia value="1.020000" />
      <fClutchChangeRateScaleUpShift value="2.250000" />
      <fClutchChangeRateScaleDownShift value="2.050000" />

      <!-- 실제 최고속도는 cookie_tuningshop에서 180~205 km/h 제어 -->
      <fInitialDriveMaxFlatVel value="180.000000" />

      <!-- 제동 -->
      <fBrakeForce value="1.173000" />
      <fBrakeBiasFront value="0.600000" />
      <fHandBrakeForce value="0.680000" />

      <!-- 컴팩트카답게 민첩한 조향 -->
      <fSteeringLock value="42.350000" />

      <!-- 접지: 안정적이지만 스포츠카급은 아님 -->
      <fTractionCurveMax value="2.938000" />
      <fTractionCurveMin value="2.662000" />
      <fTractionCurveLateral value="22.500000" />
      <fTractionSpringDeltaMax value="0.135000" />
      <fLowSpeedTractionLossMult value="0.760000" />
      <fCamberStiffnesss value="0.000000" />

      <!-- FWD 특성상 약한 언더스티어 -->
      <fTractionBiasFront value="0.505000" />
      <fTractionLossMult value="0.920000" />

      <!-- 소형차답게 비교적 탄탄한 서스펜션 -->
      <fSuspensionForce value="2.460000" />
      <fSuspensionCompDamp value="1.550000" />
      <fSuspensionReboundDamp value="2.280000" />
      <fSuspensionUpperLimit value="0.085000" />
      <fSuspensionLowerLimit value="-0.110000" />
      <fSuspensionRaise value="0.000000" />
      <fSuspensionBiasFront value="0.540000" />

      <!-- 차체 롤 억제 -->
      <fAntiRollBarForce value="1.120000" />
      <fAntiRollBarBiasFront value="0.560000" />
      <fRollCentreHeightFront value="0.125000" />
      <fRollCentreHeightRear value="0.135000" />

      <!-- 일반 소형차 내구도 -->
      <fCollisionDamageMult value="0.950000" />
      <fWeaponDamageMult value="1.000000" />
      <fDeformationDamageMult value="0.900000" />
      <fEngineDamageMult value="0.950000" />

      <fPetrolTankVolume value="45.000000" />
      <fOilVolume value="4.500000" />

      <fSeatOffsetDistX value="0.000000" />
      <fSeatOffsetDistY value="0.000000" />
      <fSeatOffsetDistZ value="0.000000" />

      <nMonetaryValue value="25000" />

      <strModelFlags>440010</strModelFlags>
      <strHandlingFlags>0</strHandlingFlags>
      <strDamageFlags>0</strDamageFlags>
      <AIHandling>AVERAGE</AIHandling>

      <SubHandlingData>
        <Item type="NULL" />
        <Item type="NULL" />
        <Item type="NULL" />
      </SubHandlingData>
    </Item>
  </HandlingData>
</CHandlingDataMgr>
